{
  "name": "mira",
  "version": "1.0.0",
  "description": "MIRA: a private on-device assistant that reads notifications from the apps you choose, reports what matters, and handles what you have approved. No internet access of its own.",
  "type": "module",
  "scripts": {
    "verify:agent": "node scripts/baton.mjs verify",
    "sync:status": "node scripts/baton.mjs status",
    "sync:reset": "node scripts/baton.mjs reset",
    "skill:list": "node scripts/skills-manager.mjs list",
    "skill:enable": "node scripts/skills-manager.mjs enable",
    "skill:disable": "node scripts/skills-manager.mjs disable",
    "skill:sync": "node scripts/skills-manager.mjs sync",
    "init:project": "node scripts/init-project.mjs",
    "hook:install": "node scripts/install-hooks.mjs",
    "check": "npm --prefix mobile run typecheck && npm --prefix mobile test",
    "test": "npm --prefix mobile test --",
    "test:tooling": "python3 -m unittest discover tests"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "antigravity",
    "pair-programming",
    "hackathon"
  ],
  "author": "",
  "license": "MIT"
}
